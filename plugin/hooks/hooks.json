{
  "description": "spec-flow: no edits on the main branch, approval gate, protected state files, git guard, test first, English only, verifier verdict recording",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          { "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}/scripts/approve.sh\" --prompt" }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}/scripts/guard-git.sh\"" }
        ]
      },
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit|Bash",
        "hooks": [
          { "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}/scripts/guard-main.sh\"" },
          { "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}/scripts/gate-files.sh\"" }
        ]
      },
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          { "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}/scripts/tdd-guard.sh\"" }
        ]
      },
      {
        "matcher": "SubagentHandback",
        "hooks": [
          { "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}/scripts/verifier-hooks.sh\" handback" }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          { "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}/scripts/check-language.sh\" --post" },
          { "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}/scripts/approve.sh\" --edited" }
        ]
      },
      {
        "matcher": "AskUserQuestion",
        "hooks": [
          { "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}/scripts/approve.sh\" --answer" }
        ]
      }
    ],
    "SubagentStart": [
      {
        "matcher": "^spec-flow:change-verifier$",
        "hooks": [
          { "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}/scripts/verifier-hooks.sh\" start" }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "^spec-flow:change-verifier$",
        "hooks": [
          { "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}/scripts/verifier-hooks.sh\" stop" }
        ]
      }
    ]
  }
}
