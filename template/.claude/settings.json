{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "model": "opus",
  "extraKnownMarketplaces": {
    "spec-flow": {
      "source": { "source": "github", "repo": "hovorun-art/spec-flow-template" }
    }
  },
  "enabledPlugins": {
    "spec-flow@spec-flow": true
  },
  "permissions": {
    "allow": [
      "Bash(openspec list:*)",
      "Bash(openspec status:*)",
      "Bash(openspec show:*)",
      "Bash(openspec instructions:*)",
      "Bash(openspec context:*)",
      "Bash(openspec validate:*)",
      "Bash(npm test:*)",
      "Bash(npm run typecheck:*)",
      "Bash(npm run lint:*)",
      "Bash(npm run build:*)",
      "Bash(npm run --silent:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git branch:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./**/*.pem)",
      "Read(./**/*.key)"
    ]
  }
}
